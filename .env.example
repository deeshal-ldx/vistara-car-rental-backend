PORT=8000
NODE_ENV=production

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=car-rental-mauritius
JWT_SECRET=change-me

# MobiPaid — use test keys in sandbox, live keys in production
# Note: do not send customer_ip in API requests for this merchant (MobiPaid rejects it)
MOBI_PAID_API_KEY=mp_test_your_key_here
MOBI_PAID_MODE=test

# Public HTTPS URLs (required for MobiPaid — do NOT use localhost in production)
FRONTEND_URL=https://www.vistaracarrentalmauritius.com
BACKEND_URL=https://app.vistaracarrentalmauritius.com

# Optional comma-separated extra CORS origins
# CORS_ORIGINS=
