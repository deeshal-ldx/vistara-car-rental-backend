# Copy to deploy.env on the server (same folder as deploy.sh or repo root):
#   cp scripts/deploy.env.example scripts/deploy.env
#
# deploy.env is gitignored — safe for server-specific paths.

# Git
GIT_REMOTE=origin
GIT_BRANCH=main

# Linux user that owns the app (git/npm/pm2 run as this user when script is run as root)
DEPLOY_USER=vistara

# Absolute path to the backend repo on the server
APP_DIR=/home/vistara/vistara-car-rental-backend

# PM2 process name
PM2_APP_NAME=vistara-car-rental-backend

# PM2 start command when process does not exist yet
PM2_START_CMD=npm -- start

# Health check after deploy (leave empty to skip)
HEALTH_URL=http://127.0.0.1:8000/api/v1/health

# Set to 1 to run `git reset --hard origin/<branch>` instead of pull (after repo migration / force-push)
GIT_RESET_HARD=0
